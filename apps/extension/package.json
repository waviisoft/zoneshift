{
  "name": "@zoneshift/extension",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "typecheck": "wxt prepare && tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:chrome": "wxt build"
  },
  "dependencies": {
    "@zoneshift/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
